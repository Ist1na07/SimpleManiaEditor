<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LumaChart.Application\LumaChart.Application.csproj" />
    <ProjectReference Include="..\LumaChart.Core\LumaChart.Core.csproj" />
    <ProjectReference Include="..\LumaChart.Online\LumaChart.Online.csproj" />
    <ProjectReference Include="..\LumaChart.Storage.Abstractions\LumaChart.Storage.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\app-icon.png"
                      Link="Assets\app-icon.png" />
    <None Include="..\README.md"
          Link="README.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\THIRD-PARTY-NOTICES.md"
          Link="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!--
      The IPADIC and OFL licences have to travel with the things they cover, not
      merely be linked to: NAIST/ICOT requires its notice on every copy of the
      dictionary, and OFL 1.1 requires its text to accompany the font. Both are
      shipped by all three clients, so all three carry these files.
    -->
    <None Include="..\LICENSE"
          Link="LICENSE"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\licenses\*.txt"
          Link="licenses\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.0" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Win32" Version="12.1.0" />
    <PackageReference Include="Kawazu" Version="1.1.4" />
    <PackageReference Include="LibNMeCab.IpaDicBin" Version="0.10.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <!-- Fully managed MP3 frame decoder. NAudio's default decompressor is the
         Windows ACM codec, which does not exist on Android or iOS. -->
    <PackageReference Include="NLayer.NAudioSupport" Version="2.0.1" />
    <PackageReference Include="OggVorbisEncoder" Version="1.2.2" />
    <PackageReference Include="SoundTouch.Net.NAudioSupport.Core" Version="2.3.2" />
    <PackageReference Include="WanaKana-net" Version="1.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SimpleManiaEditor</AssemblyName>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Product>SimpleManiaEditor</Product>
    <Company>LumaChart</Company>
    <Authors>LumaChart</Authors>
    <Description>Windows-only Avalonia migration client for LumaChart Studio.</Description>
    <Copyright>Copyright © LumaChart contributors</Copyright>
    <Version>0.1.8</Version>
    <AssemblyVersion>0.1.8.0</AssemblyVersion>
    <FileVersion>0.1.8.0</FileVersion>
  </PropertyGroup>

</Project>
