<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LumaChart.Application\LumaChart.Application.csproj" />
    <ProjectReference Include="..\LumaChart.Avalonia\LumaChart.Avalonia.csproj" />
    <ProjectReference Include="..\LumaChart.Core\LumaChart.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Executable project references do not flow every runtime package into the
         Specs host .deps.json. Keep the real Windows Vorbis adapter executable
         here instead of silently replacing it with the recording fake. -->
    <PackageReference Include="OggVorbisEncoder" Version="1.2.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
