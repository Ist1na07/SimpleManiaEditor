<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>SimpleManiaEditor.OsuHost</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.38</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Latest compatible 3.1 release; upstream framework ABI excludes 4.x.
         Track these upstream advisories rather than disabling NuGet auditing. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <!-- Matches upstream's deliberate AutoMapper 13 pin. Never disable auditing globally. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
    <Compile Include="../LumaChart.Application/Workspaces/OsuFileSafetyPolicy.cs" Link="Safety/OsuFileSafetyPolicy.cs" />
    <ProjectReference Include="../SimpleManiaEditor.PlaytestBridge/SimpleManiaEditor.PlaytestBridge.csproj" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- Same ABI patch level; security updates for transitive official-client dependencies. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Common" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.13" />
    <PackageReference Include="MessagePack" Version="3.1.9" />
    <PackageReference Include="ppy.osu.Game" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Mania" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Osu" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Taiko" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Catch" Version="2026.916.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../licenses/osu-*.txt;../licenses/osu-*.md" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
